<Window x:Class="ChinaMan.ViewedMovieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChinaMan"
        mc:Ignorable="d"
        Title="Добавить просмотр фильма"
        SizeToContent="Height"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Название" Margin="0,0,0,4"/>
        <TextBox x:Name="FilmTitleInput"
                 Grid.Row="1"
                 Height="28"
                 Margin="0,0,0,12"
                 VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="2" Text="Оценка" Margin="0,0,0,4"/>
        <ComboBox x:Name="ViewRatingInput"
                  Grid.Row="3"
                  Height="28"
                  Margin="0,0,0,12"
                  VerticalContentAlignment="Center">
            <TextBlock>
                0
            </TextBlock>
            <TextBlock>
                1
            </TextBlock>
            <TextBlock>
                2
            </TextBlock>
            <TextBlock>
                3
            </TextBlock>
            <TextBlock>
                4
            </TextBlock>
            <TextBlock>
                5
            </TextBlock>
            <TextBlock>
                6
            </TextBlock>
            <TextBlock>
                7
            </TextBlock>
            <TextBlock>
                8
            </TextBlock>
            <TextBlock>
                9
            </TextBlock>
            <TextBlock>
                10
            </TextBlock>
        </ComboBox>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Width="80"
                    Height="28"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button x:Name="SaveButton"
                    Content="Добавить"
                    Width="80"
                    Height="28"
                    IsDefault="True"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

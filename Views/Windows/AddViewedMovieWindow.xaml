<Window x:Class="ChinaMan.AddViewedMovieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChinaMan"
        mc:Ignorable="d"
        Title="Добавить просмотр"
        SizeToContent="Height"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Фильм: задел — ItemsSource/SelectedItem привязать к ViewModel -->
        <TextBlock Grid.Row="0" Text="Фильм" Margin="0,0,0,4"/>
        <TextBox x:Name="FilmTitleInput"
                 Grid.Row="1"
                 Height="28"
                 Margin="0,0,0,12"
                 VerticalContentAlignment="Center"/>
        <!-- Кнопки: задел — Command привязать к ViewModel -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Width="80"
                    Height="28"
                    Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button x:Name="SaveButton"
                    Content="Добавить"
                    Width="80"
                    Height="28"
                    IsDefault="True"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>
